# ============================================================
# 菌核狂潮 / Roguelike — Unity 工程
# 建立于 2026-09-16
#
# 原则：只提交「源码 + 资源 + 配置 + 文档」。
#       Unity 能重新生成的、或随本机状态变化的，一律忽略。
#       注意 *.meta 文件**必须提交**（不要在此文件里忽略它们）。
# ============================================================

# ---------- Unity 生成物（开一次编辑器就会重建） ----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
sysinfo.txt
*.stackdump
crashlytics-build.properties
*.apk
*.aab
*.unitypackage

# ---------- IDE / 自动生成的工程文件 ----------
# Unity 每次打开工程都会重新生成 .sln 与 *.csproj
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/*.log
*.tmp

# ---------- 本机 / 运行时状态（每次会话都变，进来只会制造噪音） ----------
# Codely 桥接的心跳文件：端口、seq、last_heartbeat 每次都更新
.com-unity-codely.json
.claude/settings.local.json
*.pid

# ---------- 第三方工具快照 ----------
# Unity-Skills-main 是下载来的 GitHub 快照（108MB，自带 LICENSE/README/.github），
# 不属于本项目源码。2026-09-16 决定不入仓。
#
# ⚠ 副作用：Packages/manifest.json 里有
#     "com.besty.unity-skills": "file:../Unity-Skills-main/SkillsForUnity"
#   把本仓库克隆到别处时，这个相对路径会断，Unity 会报「包找不到」。
#   届时需另行获取该工具，或把该依赖摘掉。
Unity-Skills-main/

# ---------- 第三方素材：本地保留，不入公开仓库 ----------
# 本仓库 2026-09-17 推送到 GitHub **公开**仓库。以下两处是第三方版权内容，
# 推上去等于再分发；而素材许可（Docs/Design/h5 风险 R11 / P0）至今未读，故排除。
#
# ⚠ 这两处的内容**仍在本地磁盘上**（只是不再进 git），
#   Docs/Design/h5/index.html 照常能双击打开。
#   换机器时需另行获取：
#     - Docs/Design/h5/assets/  ← 外部素材包 D:\AI编程\成套资源_ZOMBIE TDS 2D GAME KIT
#                                  （提取/合成脚本见 Docs/Design/_tools/，可重跑）
#     - .claude/skills/         ← Unity-Skills-main 的技能文档副本
Docs/Design/h5/assets/
.claude/skills/

# ---------- 游戏美术（临时保护） ----------
# Assets/Art/ 是从 craftpix「Zombie TDS 2D Game Kit」拆帧导入的商业素材。
#
# ⚠ 本仓库当前是**公开**的（origin → github.com/qwer-123-123/Roguelike，匿名可访问），
#   而素材许可尚未确认，公开再分发有风险 —— 当初 Docs/Design/h5/assets/ 正是
#   为避免这一点才从全部历史中摘除的。
#
# 处理：用户正在把仓库改为私有。**确认改为私有无误后，删掉下面这一行并提交素材。**
#   （见 Docs/Plans/2026-09-22-计划-兵种系统与美术落地.md 的风险 R1）
Assets/Art/

# ---------- 本机调试产物 ----------
# _tools/ 下的脚本要入仓（用来重新生成素材），但它们的输出与浏览器临时目录不入仓
Docs/Design/_tools/out/
Docs/Design/_tools/edgetmp/

# 无头浏览器（msedge --user-data-dir）产生的临时配置目录。
# ⚠ 教训：早期只写死了 edgetmp/，而调试脚本用的是 edge_$RANDOM / ep_$RANDOM$RANDOM
#   这类**随机名**，结果一次 git add -A 把 3279 个浏览器配置文件（含 History/
#   Login Data/Cookies 空库与 ~7MB 崩溃转储）提交进了公开仓库。
#   凡是给浏览器指定 user-data-dir 的脚本，务必让它生成到已忽略的路径下，
#   别用随机名散落在 _tools/ 里。
Docs/Design/_tools/edge_*/
Docs/Design/_tools/ep_*/
Docs/Design/_tools/*_profile/
**/.browser-profile/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
